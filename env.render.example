# Valori da copiare in Render → Environment

SECRET_KEY=incolla-qui-la-chiave-generata
APP_PASSWORD=scegli-una-password-tua

# Google Drive (persistenza)
# 1) Incolla l'intero JSON della service account su UNA sola riga
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# 2) ID della cartella Drive condivisa con la service account
GOOGLE_DRIVE_FOLDER_ID=1abcDEFxxxxxxxx
